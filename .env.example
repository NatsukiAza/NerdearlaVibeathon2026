# GEMINI_API_KEY — API key de Gemini; vacío → FakeSpeechBackend + FakeTranslator.
GEMINI_API_KEY=

# SPEECH_BACKEND — omitir para resolución automática (gemini si hay key, si no fake).
# Descomentar solo para forzar: fake | gemini
# SPEECH_BACKEND=fake

# PRODUCTION_TOKEN — obligatorio en compose; valor local de desarrollo únicamente.
PRODUCTION_TOKEN=dev-token

# CORS_ORIGIN — origen permitido para el browser (VistaAudiencia / Overlay / Monitor).
CORS_ORIGIN=http://localhost:5173

# API_HOST — bind del proceso uvicorn.
API_HOST=0.0.0.0

# API_PORT — puerto HTTP del API.
API_PORT=8000

# WEB_ORIGIN — origen documental de la SPA (mismo default que CORS).
WEB_ORIGIN=http://localhost:5173

# VITE_API_BASE — URL que el browser usa para llamar al API (host localhost, no DNS Docker `api`).
VITE_API_BASE=http://localhost:8000
